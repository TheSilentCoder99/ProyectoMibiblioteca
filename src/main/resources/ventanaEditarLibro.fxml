<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="15" alignment="TOP_CENTER"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.alan.controladores.ventanaEditarLibroController">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Editar Libro" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
    <Separator/>

    <GridPane hgap="10" vgap="10">
        <padding>
            <Insets top="10" bottom="10"/>
        </padding>

        <!-- Fila 1: titulo (obligatorio) -->
        <Label text="Título:" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-font-weight: bold;"/>
        <TextField fx:id="inputTitulo" GridPane.columnIndex="1" GridPane.rowIndex="1"
                   promptText="Ej:Gabriel" prefWidth="400"/>
        <Label text="*" textFill="red" GridPane.columnIndex="2" GridPane.rowIndex="1"/>

        <!-- Fila 2: publicación -->
        <Label text="Publicación:" GridPane.columnIndex="1" GridPane.rowIndex="2" style="-fx-font-weight: bold;"/>
        <TextField fx:id="inputYearPublicacion" GridPane.columnIndex="1" GridPane.rowIndex="2"
                   promptText="Ej: García"/>

        <!-- Fila 3: Número de páginas -->
        <Label style="-fx-font-weight: bold;" text="Páginas:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <TextField fx:id="inputPaginas" promptText="Ej: 496" GridPane.columnIndex="1" GridPane.rowIndex="2" />
        <Label text="*" textFill="red" GridPane.columnIndex="2" GridPane.rowIndex="2" />

        <!-- Fila 4: Descripción -->
        <Label style="-fx-font-weight: bold;" text="Descripción:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
        <TextArea fx:id="inputDescripcion" prefHeight="100" promptText="Sinopsis o descripción del libro..." GridPane.columnIndex="1" GridPane.rowIndex="3" wrapText="true"/>

        <!-- Fila 5: Opinión personal -->
        <Label style="-fx-font-weight: bold;" text="Opinión:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
        <TextArea fx:id="inputOpinion" prefHeight="126.0" prefWidth="516.0" promptText="Tu opinión sobre el libro..." GridPane.columnIndex="1" GridPane.rowIndex="4" wrapText="true"/>

        <!-- Fila 8: Mensaje -->
        <Label fx:id="lblMensaje" GridPane.columnIndex="1" GridPane.rowIndex="7"/>
    </GridPane>

    <Separator/>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Actualizar" onAction="#actualizarLibro" fx:id="btnActualizar" style="-fx-background-color: #2196F3; -fx-text-fill: white;"/>
        <Button text="Cancelar" onAction="#cerrarVentanaEditarLibro" fx:id="btnCancelar"/>
    </HBox>

</VBox>