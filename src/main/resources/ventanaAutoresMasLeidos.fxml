<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="15" alignment="TOP_CENTER" 
      xmlns="http://javafx.com/javafx/21" 
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.alan.controladores.autoresMasLeidosController">
    
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
    
    <Label text="AUTORES MÁS LEÍDOS" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
    <Separator/>
    
    <TableView fx:id="tablaAutoresMasLeidos" prefHeight="500">
        <columns>
            <TableColumn fx:id="colid" text="ID" prefWidth="200"/>
            <TableColumn fx:id="colNombre" text="Nombre" prefWidth="200"/>
            <TableColumn fx:id="colApellido1" text="Primer Apellido" prefWidth="150"/>
            <TableColumn fx:id="colApellido2" text="Segundo Apellido" prefWidth="150"/>
            <TableColumn fx:id="colCantidadLibros" text="Nº Libros" prefWidth="100"/>
        </columns>
    </TableView>

    <TableView fx:id="mostrarLibroAutor" prefHeight="500">
        <columns>
            <TableColumn fx:id="colTituloLibroAutor" text="Título" prefWidth="200"/>
            <TableColumn fx:id="colPaginaLibroAutor" text="Páginas" prefWidth="150"/>
            <TableColumn fx:id="colPublicacionLibroAutor" text="Fecha publicación" prefWidth="100"/>
        </columns>
    </TableView>

    
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Cerrar" onAction="#cerrarVentana" />
    </HBox>
    
</VBox>
