<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="15" alignment="TOP_CENTER" 
      xmlns="http://javafx.com/javafx/21" 
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.alan.controladores.cantidadLIbrosPorGeneroController">
    
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
    
    <Label text="CANTIDAD DE LIBROS POR GÉNERO" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
    <Separator/>
    
    <TableView fx:id="numLibrosPorGenero" prefHeight="500">
        <columns>
            <TableColumn fx:id="colGenero" text="Género" prefWidth="400"/>
            <TableColumn fx:id="colCantidad" text="Nº de libros" prefWidth="200"/>
        </columns>
    </TableView>

    <TableView fx:id="tablaTitulosPorGenero" prefHeight="500">
        <columns>
            <TableColumn fx:id="colTitulo" text="Título" prefWidth="200"/>
            <TableColumn fx:id="colPages" text="Páginas" prefWidth="200"/>
            <TableColumn fx:id="colPublicacion" text="Publicación" prefWidth="200"/>
        </columns>
    </TableView>
    
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Cerrar" onAction="#cerrarVentana" />
    </HBox>
    
</VBox>
