<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="15" alignment="TOP_CENTER" 
      xmlns="http://javafx.com/javafx/21" 
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.alan.controllers.ventanaAddGeneroController">
    
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
    
    <Label text="Añadir Nuevo Género" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
    <Separator/>
    
    <GridPane hgap="10" vgap="10">
        <padding>
            <Insets top="10" bottom="10"/>
        </padding>
        
        <Label text="Nombre del género:" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-font-weight: bold;"/>
        <TextField fx:id="txtNombre" GridPane.columnIndex="1" GridPane.rowIndex="0" 
                   promptText="Ej: Distopía, Novela histórica, Ensayo, Terror..." prefWidth="400"/>
        <Label text="*" textFill="red" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
        
        <Label fx:id="lblMensaje" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
    </GridPane>
    
    <Separator/>
    
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Guardar" fx:id="btnGuardar" style="-fx-background-color: #4CAF50; -fx-text-fill: white;"/>
        <Button text="Cancelar" fx:id="btnCancelar"/>
    </HBox>
    
</VBox>