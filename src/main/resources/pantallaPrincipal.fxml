<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.alan.controladores.pantallaPrincipalController">

  <!-- MENÚ -->
  <MenuBar VBox.vgrow="NEVER">
    <menus>
      <Menu text="File">
        <items>
          <MenuItem text="New"/>
          <MenuItem text="Open…"/>
          <SeparatorMenuItem/>
          <MenuItem text="Quit"/>
        </items>
      </Menu>
      <Menu text="Edit">
        <items>
          <MenuItem text="Undo"/>
          <MenuItem text="Redo"/>
        </items>
      </Menu>
      <Menu text="Help">
        <items>
          <MenuItem text="About"/>
        </items>
      </Menu>
    </menus>
  </MenuBar>

  <!-- BARRA SUPERIOR: BOTONES AÑADIR + BUSCADOR -->
  <HBox spacing="10" VBox.vgrow="NEVER">
    <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
    <Button fx:id="addLibro" text="Añadir libro" onAction="#cambiarVentanas"/>
    <Button fx:id="addAutor" text="Añadir autor" onAction="#cambiarVentanas"/>
    <Button fx:id="addGenero" text="Añadir género" onAction="#cambiarVentanas"/>
    <TextField fx:id="inputBuscarLibro" promptText="Buscar por título..." HBox.hgrow="ALWAYS"/>
    <TextField fx:id="inputBuscarAutor" promptText="Buscar por nombre o apellido..." HBox.hgrow="ALWAYS" visible="false" managed="false"/>
    <TextField fx:id="inputBuscarGenero" promptText="Buscar género..." HBox.hgrow="ALWAYS" visible="false" managed="false"/>
  </HBox>

  <!-- CONTENIDO PRINCIPAL -->
  <HBox spacing="10" VBox.vgrow="ALWAYS">
    <padding><Insets right="10" bottom="0" left="10"/></padding>

    <!-- TABLAS PRINCIPALES -->
    <TableView fx:id="mostrarLibros" HBox.hgrow="ALWAYS">
      <columns>
        <TableColumn fx:id="colTitulo" text="Título"/>
        <TableColumn fx:id="colPaginas" text="Páginas"/>
        <TableColumn fx:id="colPublicacion" text="Año"/>
      </columns>
    </TableView>

    <TableView fx:id="mostrarAutores" HBox.hgrow="ALWAYS" visible="false" managed="false">
      <columns>
        <TableColumn fx:id="colNombreAutor" text="Nombre"/>
        <TableColumn fx:id="colApellidoAutor" text="Apellido"/>
        <TableColumn fx:id="colApellido2Autor" text="Apellido 2"/>
        <TableColumn fx:id="colNacimiento" text="Nacimiento"/>
        <TableColumn fx:id="colFallecimiento" text="Fallecimiento"/>
        <TableColumn fx:id="colPaisAutor" text="País"/>
      </columns>
    </TableView>

    <TableView fx:id="mostrarGeneros" HBox.hgrow="ALWAYS" visible="false" managed="false">
      <columns>
        <TableColumn fx:id="colIDGenero" text="ID"/>
        <TableColumn fx:id="colNombreGenero" text="Género"/>
      </columns>
    </TableView>

    <!-- PANEL LATERAL -->
    <VBox fx:id="panelLateral" spacing="10" prefWidth="400" visible="false" managed="false">
      <Label fx:id="mostrarDescripcion" text="Selecciona para ver la sinopsis..." wrapText="true"/>
      <TableView fx:id="mostrarLibroAutor" VBox.vgrow="ALWAYS">
        <columns>
          <TableColumn fx:id="colTituloLibroAutor" text="Título"/>
          <TableColumn fx:id="colPaginaLibroAutor" text="Páginas"/>
          <TableColumn fx:id="colPublicacionLibroAutor" text="Publicación"/>
        </columns>
      </TableView>
    </VBox>

  </HBox>

  <!-- BARRA INFERIOR -->
  <HBox spacing="10" VBox.vgrow="NEVER">
    <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
    <Button fx:id="mostrarAllLibros" text="Ver todos los libros" onAction="#mostrarLibros"/>
    <Button fx:id="mostrarAllAutores" text="Ver todos los autores" onAction="#mostrarAutores"/>
    <Button fx:id="mostrarAllGeneros" text="Ver todos los géneros" onAction="#mostrarGeneros"/>
    <Button fx:id="botonEliminarElemento" text="Eliminar" onAction="#eliminarElemento"/>
  </HBox>

</VBox>