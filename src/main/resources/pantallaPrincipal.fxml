            <Button fx:id="mostrarAllAutores" onAction="#mostrarAutores" layoutX="239.0" layoutY="309.0" mnemonicParsing="false" text="Ver todos los autores" />
            <Button fx:id="mostrarAllGeneros" onAction="#mostrarGeneros" layoutX="394.0" layoutY="309.0" mnemonicParsing="false" text="Ver todos los géneros" />
